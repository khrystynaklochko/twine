{
  "manifest_version": 3,
  "name": "TwinMe Studio — Explicit Teach Recorder",
  "version": "1.1.0",
  "description": "Opt-in per-site demonstration recorder for TwinMe Studio. Streams redacted browser actions to your personal twin for later replication.",
  "permissions": ["activeTab", "tabs", "storage"],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://*.run.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TwinMe Teach Mode"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
